{
  "title": "API Garage - Logs Metrics (Loki)",
  "uid": "api-garage-loki-metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": ["api-garage", "loki", "logs"],
  "panels": [
    {
      "id": 1,
      "title": "Log volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service_name=\"api-garage\"}[$__interval]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Log volume by level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (detected_level) (count_over_time({service_name=\"api-garage\"}[$__interval]))",
          "legendFormat": "{{detected_level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service_name=\"api-garage\", detected_level=~\"error|warn\"}[$__interval]))",
          "legendFormat": "errors + warnings",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"api-garage\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
