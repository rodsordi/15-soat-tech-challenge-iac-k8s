{
  "name": "API Garage - Ordens de Serviço & Negócio",
  "description": "Monitoramento executivo de Ordens de Serviço, tempo médio por status e SLAs",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Work Orders & SLAs",
      "widgets": [
        {
          "title": "Volume Diário de Ordens de Serviço Criadas",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'Ordens Criadas' FROM Metric WHERE metricName = 'http.server.requests' AND uri = '/v1/work-orders' AND method = 'POST' AND status = '201' FACET dateOf(timestamp) SINCE 14 days ago"
              }
            ]
          }
        },
        {
          "title": "Distribuição de Requisições por Rota de Ordem de Serviço",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.pie" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) FROM Metric WHERE metricName = 'http.server.requests' AND uri LIKE '%/work-orders%' FACET uri SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Tempo Médio de Execução por Rota de Work Order (ms)",
          "layout": { "column": 1, "row": 4, "width": 8, "height": 4 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT average(http.server.requests) * 1000 AS 'Tempo Médio (ms)' FROM Metric WHERE metricName = 'http.server.requests' AND uri LIKE '%/work-orders%' FACET uri TIMESERIES SINCE 24 hours ago"
              }
            ]
          }
        },
        {
          "title": "Taxa de Sucesso vs Falha no Processamento de OS (%)",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 4 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT percentage(count(*), WHERE status LIKE '2%' OR status LIKE '3%') AS 'Taxa de Sucesso (%)' FROM Metric WHERE metricName = 'http.server.requests' AND uri LIKE '%/work-orders%' SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    }
  ]
}
