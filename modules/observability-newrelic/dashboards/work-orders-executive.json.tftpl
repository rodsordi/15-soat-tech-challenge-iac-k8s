{
  "name": "API Garage - Ordens de Serviço & Negócio",
  "description": "Monitoramento executivo de Ordens de Serviço, tempo médio por status e SLAs",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Work Orders & SLAs",
      "widgets": [
        {
          "title": "Volume Diário de Ordens de Serviço Criadas",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'Ordens Criadas' FROM Transaction WHERE request.uri = '/api/v1/work-orders' AND request.method = 'POST' AND response.status = '201' FACET dateOf(timestamp) SINCE 14 days ago"
              }
            ]
          }
        },
        {
          "title": "Distribuição Atual de Ordens por Status",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.pie" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) FROM Transaction WHERE request.uri LIKE '%/work-orders%' AND request.method = 'PATCH' FACET request.parameters.status SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Tempo Médio de Execução por Status (Diagnóstico, Execução, Finalização)",
          "layout": { "column": 1, "row": 4, "width": 8, "height": 4 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT average(duration) * 1000 AS 'Tempo Médio (ms)' FROM Transaction WHERE request.uri LIKE '%/work-orders%' FACET request.parameters.status TIMESERIES SINCE 24 hours ago"
              }
            ]
          }
        },
        {
          "title": "Taxa de Sucesso vs Falha no Processamento de OS (%)",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 4 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT percentage(count(*), WHERE numeric(response.status) < 400) AS 'Taxa de Sucesso (%)' FROM Transaction WHERE request.uri LIKE '%/work-orders%' SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    }
  ]
}
