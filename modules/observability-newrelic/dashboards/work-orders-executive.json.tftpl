{
  "name": "API Garage - Painel Executivo de Negocios & SLAs",
  "description": "Monitoramento executivo do Tempo Medio de Execucao por Status de Ordens de Servico (Diagnostico, Execucao, Finalizacao)",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Work Orders & SLAs Executivos",
      "widgets": [
        {
          "title": "Tempo Medio de Execucao por Status (Diagnostico, Execucao, Finalizacao)",
          "layout": { "column": 1, "row": 1, "width": 12, "height": 7 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT average(garage.workorder.status.duration) / 1000 AS 'Tempo Medio (s)' FROM Metric WHERE metricName = 'garage.workorder.status.duration' FACET status SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    }
  ]
}